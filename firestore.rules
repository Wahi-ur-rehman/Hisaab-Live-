rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions that support BOTH Spark (Free) & Blaze (Paid with Cloud Functions)
    function signedIn() { 
      return request.auth != null; 
    }

    // Super Admin: Recognized by custom claim (Blaze), bootstrap email, email matching 'admin', or authenticated password provider
    function isAdmin() { 
      return signedIn() && (
        request.auth.token.admin == true || 
        (request.auth.token.email != null && (
          request.auth.token.email == 'admin@hisaablive.com' ||
          request.auth.token.email.matches('.*[aA][dD][mM][iI][nN].*')
        )) ||
        (request.auth.token.email != null && 'firebase' in request.auth.token && request.auth.token.firebase.sign_in_provider == 'password')
      ); 
    }

    // Shop Owner: Isolated by custom claim token (Blaze), shop UID, or shop-specific identity
    function isOwner(shopId) { 
      return signedIn() && (
        request.auth.token.shopId == shopId ||
        request.auth.uid == 'shop_' + shopId ||
        (request.auth.token.email != null && (
          request.auth.token.email == shopId ||
          request.auth.token.email == shopId + '@hisaablive.com'
        ))
      ); 
    }

    // Check if shop document is active
    function shopActive(shopId) {
      return !exists(/databases/$(database)/documents/shops/$(shopId)) ||
        get(/databases/$(database)/documents/shops/$(shopId)).data.status == 'active';
    }

    function canAccessShop(shopId) { 
      return isAdmin() || (isOwner(shopId) && shopActive(shopId)); 
    }

    // Shops Root Document
    match /shops/{shopId} {
      // Any client can read the shop profile to verify code/status; only Super Admin can create/edit/delete
      allow read: if true;
      allow write: if isAdmin();

      // Subcollections: Super Admin and active Shop Owners can read and write
      // Expenses Subcollection (Daily operating expenses)
      match /expenses/{expenseId} {
        allow read: if signedIn();
        allow write: if isAdmin() || canAccessShop(shopId) || signedIn();
      }
      match /daily_sales/{day} {
        allow read, write: if canAccessShop(shopId);
      }
      match /monthly_summary/{ym} {
        allow read, write: if canAccessShop(shopId);
      }
      match /bills/{billId} {
        allow read, write: if canAccessShop(shopId);
      }
      match /bill_days/{day} {
        allow read, write: if canAccessShop(shopId);
      }
      match /alerts/{alertId} {
        allow read: if signedIn();
        allow write: if isAdmin() || canAccessShop(shopId) || signedIn();
      }
      match /khata_customers/{customerId} {
        allow read, write: if canAccessShop(shopId) || signedIn() || true;

        match /entries/{entryId} {
          allow read, write: if canAccessShop(shopId) || signedIn() || true;
        }
      }
    }

    // Super Admin Announcement Logs & Notifications (readable by all signed-in users or clients)
    match /admin_notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Internal configurations and setup codes
    match /shops_private/{shopId} {
      allow read, write: if isAdmin();
    }
    match /setup_codes/{id} {
      allow read, write: if isAdmin();
    }
    match /rate_limits/{id} {
      allow read, write: if isAdmin();
    }
  }
}
